step by step please

Here is the complete, step-by-step guide to download your updated Excel spreadsheet from Google Colab, convert it into the product data file, and update your storefront website.

Step 1: Open Google Colab & Run the Processing Script
Open your notebook in Google Colab.

Paste and run this script in a new code cell:

Python
import pandas as pd
import json
import random
from google.colab import files

# 1. Load the original file uploaded to Colab
filepath = 'tales_print_amazon_seller_data (4).xlsx'
df = pd.read_excel(filepath, sheet_name='Product Listings')

# 2. Clean missing values
df = df.dropna(subset=['Title', 'Category']).copy()

# 3. Categorize into the 5 main Storefront sections
def assign_storefront_category(cat_str):
    if pd.isna(cat_str):
        return "Gifts & Miscellaneous"
    
    cat_lower = str(cat_str).lower()
    
    if any(k in cat_lower for k in ['kitchen', 'dining', 'tableware', 'cookware', 'cleaning', 'bath', 'laundry', 'scrubbing', 'appliances']):
        return "Kitchen & Home Utilities"
    elif any(k in cat_lower for k in ['storage', 'organisation', 'organizer', 'holder', 'rack', 'hooks', 'home & décor', 'lighting', 'hardware']):
        return "Organization & Storage"
    elif any(k in cat_lower for k in ['beauty', 'personal care', 'health', 'hair', 'oral', 'bags', 'wallets', 'luggage', 'travel', 'sports', 'fitness']):
        return "Beauty & Travel Essentials"
    elif any(k in cat_lower for k in ['office', 'stationery', 'electronics', 'computers', 'car & motorbike', 'tools', 'industrial', 'safety']):
        return "Hardware & Office Supplies"
    else:
        return "Gifts & Miscellaneous"

df['Storefront Category'] = df['Category'].apply(assign_storefront_category)

# 4. Generate random entries for manual editing
random.seed(42)
df['Fast Selling'] = ['Yes' if random.random() < 0.22 else 'No' for _ in range(len(df))]
df['Featured'] = ['Yes' if random.random() < 0.25 else 'No' for _ in range(len(df))]

# 5. Save updated Excel file
cols = ['Position', 'SKU', 'Title', 'Price (INR)', 'In Stock', 'Storefront Category', 'Fast Selling', 'Featured', 'Category', 'ASIN', 'Product URL', 'Image 1']
df_excel = df[cols].copy()
output_excel = 'tales_print_amazon_seller_data_updated.xlsx'

with pd.ExcelWriter(output_excel, engine='openpyxl') as writer:
    df_excel.to_excel(writer, sheet_name='Product Listings', index=False)

# 6. Export JSON for the website
json_export = df[['Title', 'Price (INR)', 'In Stock', 'SKU', 'Image 1', 'Storefront Category', 'Fast Selling', 'Featured']].copy()
json_export.columns = ['title', 'price', 'stock', 'sku', 'image', 'cat', 'fast_selling', 'featured']
json_export['price'] = pd.to_numeric(json_export['price'], errors='coerce').fillna(0.0)
json_export['sku'] = json_export['sku'].astype(str)
json_export['fast_selling'] = json_export['fast_selling'] == 'Yes'
json_export['featured'] = json_export['featured'] == 'Yes'

json_export.to_json('products.json', orient='records', indent=2)

print("Files created successfully! Downloading to your computer...")

# 7. Trigger browser downloads
files.download(output_excel)
files.download('products.json')
