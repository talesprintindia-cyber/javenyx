    </div>
  </header>

  <div class="nav-search-bar">
      <h2 id="selectedCatTitle"></h2>
      <div class="nav-search"><input type="text" id="searchInput" placeholder="Search title or SKU..." onkeyup="globalSearch()"></div>
  </div>

  <div class="product-grid" id="productGrid"></div>

  <footer>
    <img src="tales-print-logo.png" alt="Tales Print Logo" class="footer-tp-logo">
  </footer>

  <a href="cart.html" class="cart-btn-fixed hidden" id="cartFixedCount">Cart (0)</a>

  <script src="cart.js"></script>
  <script>
    let products = [];
    let currentCat = localStorage.getItem('javenyx_explore_cat');

    async function init() {
      if (!currentCat) { window.location.href = 'index.html'; return; }
      document.getElementById('selectedCatTitle').textContent = currentCat;
      const res = await fetch('products.json');
      products = await res.json();
      renderProducts(products.filter(p => p.cat === currentCat));
    }

    function renderProducts(items) {
      document.getElementById('productGrid').innerHTML = items.map(p => {
        const inStock = p.stock === "Yes";
        return `
        <div class="card ${inStock ? '' : 'out-of-stock'}">
          <img src="${p.image || 'https://via.placeholder.com/170x170'}" alt="${p.title}" loading="lazy">
          <div>
            <div class="title">${p.title}</div>
            <div class="price">₹${p.price.toFixed(2)}</div>
          </div>
          <div class="qty-selector">
            <button class="qty-btn" onclick="updateQty(this, -1)">−</button>
            <span class="qty-num">1</span>
            <button class="qty-btn" onclick="updateQty(this, 1)">+</button>
          </div>
          <button class="btn-add-cart" onclick="addToCart(this, '${p.sku}')">${inStock ? 'Add to Cart' : 'OUT OF STOCK'}</button>
        </div>
      `}).join('');
    }

    init();
  </script>
</body>
</html>
