    let cart = JSON.parse(localStorage.getItem('javenyx_cart')) || [];

    const categoriesList = [
      "Kitchen & Home Utilities",
      "Organization & Storage",
      "Beauty & Travel Essentials",
      "Hardware & Office Supplies",
      "Gifts & Miscellaneous"
    ];

    async function loadProducts() {
      try {
        const res = await fetch('products.json');
        allProducts = await res.json();
        renderLayout();
        updateCartUI();
      } catch (e) {
        console.error("Failed to load products.json", e);
      }
    }

    function switchTab(tabName) {
      currentTab = tabName;
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      
      const activeBtn = Array.from(document.querySelectorAll('.tab-btn')).find(b => b.onclick.toString().includes(`'${tabName}'`));
      if (activeBtn) activeBtn.classList.add('active');

      renderLayout();
      window.scrollTo({ top: 300, behavior: 'smooth' });
    }

    function renderLayout() {
      const area = document.getElementById('mainLayoutArea');
      area.innerHTML = "";

      if (currentTab === "Home") {
        // 1. FAST SELLING ROW
        const fastSellingItems = allProducts.filter(p => p.fast_selling).slice(0, 8);
        area.appendChild(createSectionNode("⚡ Fast Selling Products", fastSellingItems, () => switchTab('FastSelling')));

        // 2. CATEGORY PREVIEWS (4 items each + See More)
        categoriesList.forEach(cat => {
          const items = allProducts.filter(p => p.cat === cat).slice(0, 4);
          if (items.length > 0) {
            area.appendChild(createSectionNode(cat, items, () => switchTab(cat)));
          }
        });
      } else if (currentTab === "FastSelling") {
        const items = allProducts.filter(p => p.fast_selling);
        area.appendChild(createSectionNode("⚡ Fast Selling Products", items, null, true));
      } else {
        const items = allProducts.filter(p => p.cat === currentTab);
        area.appendChild(createSectionNode(currentTab, items, null, true));
      }
    }

    function createSectionNode(title, items, onSeeMore, isFullView = false) {
      const sec = document.createElement('section');
      sec.style.marginBottom = "30px";

      const header = document.createElement('div');
      header.className = "section-header";

      const titleNode = document.createElement('div');
      titleNode.className = "section-title";
      titleNode.innerHTML = title.includes("Fast") ? `${title} <span class="fast-tag">HOT</span>` : title;
      header.appendChild(titleNode);

      if (onSeeMore && !isFullView) {
        const seeMore = document.createElement('a');
        seeMore.className = "see-more-btn";
        seeMore.innerText = "See More →";
        seeMore.onclick = onSeeMore;
        header.appendChild(seeMore);
      }

      sec.appendChild(header);

      const grid = document.createElement('div');
      grid.className = "product-grid";
      grid.innerHTML = items.map(p => `
        <div class="product-card">
          <img src="${p.image || 'https://via.placeholder.com/150'}" alt="${p.title}" loading="lazy">
          <div class="title" title="${p.title}">${p.title}</div>
          <div class="price-row">
            <span class="price-symbol">₹</span>
            <span class="price-whole">${p.price.toFixed(2)}</span>
          </div>
          <div class="qty-picker">
            <button class="qty-btn" onclick="adjustQty(this, -1)">-</button>
            <span class="qty-val">1</span>
            <button class="qty-btn" onclick="adjustQty(this, 1)">+</button>
          </div>
          <button class="add-cart-btn" onclick="addToCart('${p.sku}', this)">Add to Cart</button>
        </div>
      `).join('');

      sec.appendChild(grid);
      return sec;
    }

    function adjustQty(btn, delta) {
      const valSpan = btn.parentNode.querySelector('.qty-val');
      let val = parseInt(valSpan.innerText) + delta;
      if (val < 1) val = 1;
      valSpan.innerText = val;
    }

    function addToCart(sku, btn) {
      const card = btn.closest('.product-card');
      const qty = parseInt(card.querySelector('.qty-val').innerText);
      const product = allProducts.find(p => String(p.sku) === String(sku));

      if (!product) return;

      const existing = cart.find(item => String(item.sku) === String(sku));
      if (existing) {
        existing.qty += qty;
      } else {
        cart.push({ sku: String(sku), qty: qty });
      }

      localStorage.setItem('javenyx_cart', JSON.stringify(cart));
      updateCartUI();

      btn.innerText = "✓ Added";
      setTimeout(() => btn.innerText = "Add to Cart", 1200);
    }

    function updateCartUI() {
      const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
      document.getElementById('cartCount').innerText = totalCount;

      const cartBody = document.getElementById('cartBody');
      let subtotal = 0;

      cartBody.innerHTML = cart.map((item, index) => {
        const p = allProducts.find(prod => String(prod.sku) === String(item.sku));
        if (!p) return '';
        const itemTotal = p.price * item.qty;
        subtotal += itemTotal;
        return `
          <div class="cart-item">
            <img src="${p.image}" alt="${p.title}">
            <div class="cart-item-info">
              <div class="cart-item-title">${p.title}</div>
              <div class="cart-item-price">₹${p.price.toFixed(2)} × ${item.qty}</div>
              <span style="color:red; font-size:11px; cursor:pointer;" onclick="removeItem(${index})">Remove</span>
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('cartSubtotal').innerText = `₹${subtotal.toFixed(2)}`;

      let msg = "Hi Javenyx! I would like to place an order from your Storefront:\n\n";
      cart.forEach((item, i) => {
        const p = allProducts.find(prod => String(prod.sku) === String(item.sku));
        if(p) msg += `${i+1}. ${p.title} (₹${p.price}) × ${item.qty}\n`;
      });
      msg += `\n*Total Amount:* ₹${subtotal.toFixed(2)}`;

      document.getElementById('waCheckoutLink').href = `https://wa.me/${PHONE_NO}?text=${encodeURIComponent(msg)}`;
    }

    function removeItem(index) {
      cart.splice(index, 1);
      localStorage.setItem('javenyx_cart', JSON.stringify(cart));
      updateCartUI();
    }

    function toggleCart(open) {
      document.getElementById('cartOverlay').style.display = open ? 'block' : 'none';
      document.getElementById('cartDrawer').classList.toggle('open', open);
    }

    function handleSearch() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const area = document.getElementById('mainLayoutArea');
      
      if (q.length < 2) {
        renderLayout();
        return;
      }

      const matches = allProducts.filter(p => p.title.toLowerCase().includes(q) || String(p.sku).toLowerCase().includes(q));
      area.innerHTML = "";
      area.appendChild(createSectionNode(`Search Results for "${q}"`, matches, null, true));
    }

    loadProducts();
  </script>
</body>
</html>
