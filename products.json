import pandas as pd
from google.colab import files

df = pd.read_excel('tales_print_amazon_seller_data_updated.xlsx', sheet_name='Product Listings')

# Extract necessary website columns
df_clean = df[['Title', 'Price (INR)', 'In Stock', 'SKU', 'Image 1', 'Storefront Category', 'Fast Selling', 'Featured']].copy()
df_clean.columns = ['title', 'price', 'stock', 'sku', 'image', 'cat', 'fast_selling', 'featured']

