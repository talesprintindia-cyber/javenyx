The issue with empty categories occurred because the Python script was attempting to map custom sub-category labels instead of the actual top-level Amazon category names (like "Home & Kitchen" or "Home Improvement"). Consequently, every product fell back into "Gifts & Miscellaneous".

The root cause has been resolved, and a complete single-page Amazon Storefront layout has been created. It features top navigation tabs, a full-width hero banner, horizontal product carousels, and an integrated sliding cart drawer—all within a single file.

Step 1: Run the Corrected Python Script in Google Colab
Use this script in Google Colab to regenerate products.json. It maps all 504 products across the storefront categories.

Python
import pandas as pd
import json
import os

excel_file_name = 'tales_print_amazon_seller_data (4).xlsx'
output_json_name = 'products.json'

# Direct mapping from raw Amazon L1 categories to Storefront Tabs
amazon_to_storefront_mapping = {
    "Home & Kitchen": "Kitchen & Home Utilities",
    "Home Improvement": "Organization & Storage",
    "Health & Personal Care": "Beauty & Travel Essentials",
    "Beauty": "Beauty & Travel Essentials",
    "Electronics": "Hardware & Office Supplies",
    "Office Products": "Hardware & Office Supplies",
    "Outdoor Living": "Organization & Storage",
    "Toys & Games": "Gifts & Miscellaneous",
    "Bags, Wallets and Luggage": "Beauty & Travel Essentials",
    "Sports, Fitness & Outdoors": "Beauty & Travel Essentials",
    "Car & Motorbike": "Hardware & Office Supplies",
    "Industrial & Scientific": "Hardware & Office Supplies",
    "Computers & Accessories": "Hardware & Office Supplies",
    "Baby": "Gifts & Miscellaneous",
    "Clothing & Accessories": "Gifts & Miscellaneous",
    "Pet Supplies": "Gifts & Miscellaneous",
    "Jewellery": "Gifts & Miscellaneous",
    "Shoes & Handbags": "Gifts & Miscellaneous",
    "Home Medical Supplies & Equipment": "Beauty & Travel Essentials",
    "Occupational Health & Safety Products": "Hardware & Office Supplies"
}

if not os.path.exists(excel_file_name):
    print(f"Error: Could not find '{excel_file_name}'. Upload it to the left panel 📁.")
else:
    df = pd.read_excel(excel_file_name, sheet_name='Product Listings')

    def parse_amazon_category(cat_str):
        if pd.isna(cat_str):
            return "Uncategorized"
        parts = [p.strip() for p in str(cat_str).split('>')]
        return parts[0] if len(parts) > 0 else "Uncategorized"

    df['amazon_l1'] = df['Category'].apply(parse_amazon_category)
    df['MappedCat'] = df['amazon_l1'].map(amazon_to_storefront_mapping).fillna("Gifts & Miscellaneous")

    df_clean = df[['Title', 'Price (INR)', 'In Stock', 'SKU', 'Image 1', 'MappedCat']].copy()
    df_clean.columns = ['title', 'price', 'stock', 'sku', 'image', 'cat']
    df_clean['price'] = pd.to_numeric(df_clean['price'], errors='coerce').fillna(0.0)
    df_clean['sku'] = df_clean['sku'].astype(str)

    df_clean.to_json(output_json_name, orient='records', indent=2)
    print(f"Exported '{output_json_name}' with {len(df_clean)} categorized products!")
