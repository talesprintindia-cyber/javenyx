            <button class="qty-btn" onclick="adjustQty(this, 1)">+</button>
          </div>
          <button class="add-cart-btn" onclick="addToCart('${p.sku}', this)">Add to Cart</button>
        </div>
      `).join('');

      sec.appendChild(grid);
      return sec;
    }

    function adjustQty(btn, delta) {
      const valSpan = btn.parentNode.querySelector('.qty-val');
      let val = parseInt(valSpan.innerText) + delta;
      if (val < 1) val = 1;
      valSpan.innerText = val;
    }

    function addToCart(sku, btn) {
      const card = btn.closest('.product-card');
      const qty = parseInt(card.querySelector('.qty-val').innerText);
      const product = allProducts.find(p => String(p.sku) === String(sku));

      if (!product) return;

      const existing = cart.find(item => String(item.sku) === String(sku));
      if (existing) {
        existing.qty += qty;
      } else {
        cart.push({ sku: String(sku), qty: qty });
      }

      localStorage.setItem('javenyx_cart', JSON.stringify(cart));
      updateCartUI();

      btn.innerText = "✓ Added";
      setTimeout(() => btn.innerText = "Add to Cart", 1200);
    }

    function updateCartUI() {
      const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
      document.getElementById('cartCount').innerText = totalCount;

      const cartBody = document.getElementById('cartBody');
      let subtotal = 0;

      cartBody.innerHTML = cart.map((item, index) => {
        const p = allProducts.find(prod => String(prod.sku) === String(item.sku));
        if (!p) return '';
        const itemTotal = p.price * item.qty;
        subtotal += itemTotal;
        return `
          <div class="cart-item">
            <img src="${p.image}" alt="${p.title}">
            <div class="cart-item-info">
              <div class="cart-item-title">${p.title}</div>
              <div class="cart-item-price">₹${p.price.toFixed(2)} × ${item.qty}</div>
              <span style="color:red; font-size:11px; cursor:pointer;" onclick="removeItem(${index})">Remove</span>
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('cartSubtotal').innerText = `₹${subtotal.toFixed(2)}`;

      let msg = "Hi Javenyx! I would like to place an order from your Storefront:\n\n";
      cart.forEach((item, i) => {
        const p = allProducts.find(prod => String(prod.sku) === String(item.sku));
        if(p) msg += `${i+1}. ${p.title} (₹${p.price}) × ${item.qty}\n`;
      });
      msg += `\n*Total Amount:* ₹${subtotal.toFixed(2)}`;

      document.getElementById('waCheckoutLink').href = `https://wa.me/${PHONE_NO}?text=${encodeURIComponent(msg)}`;
    }

    function removeItem(index) {
      cart.splice(index, 1);
      localStorage.setItem('javenyx_cart', JSON.stringify(cart));
      updateCartUI();
    }

    function toggleCart(open) {
      document.getElementById('cartOverlay').style.display = open ? 'block' : 'none';
      document.getElementById('cartDrawer').classList.toggle('open', open);
    }

    function handleSearch() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const area = document.getElementById('mainLayoutArea');
      
      if (q.length < 2) {
        renderLayout();
        return;
      }

      const matches = allProducts.filter(p => p.title.toLowerCase().includes(q) || String(p.sku).toLowerCase().includes(q));
      area.innerHTML = "";
      area.appendChild(createSectionNode(`Search Results for "${q}"`, matches, null, true));
    }

    loadProducts();
  </script>
</body>
</html>
